rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'saahiressa@gmail.com' ||
        request.auth.token.email.lower() == 'yasmeenb518@gmail.com'
      );
    }
    
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
